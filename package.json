{
  "name": "photo-gallery",
  "version": "1.0.0",
  "type": "module",
  "description": "Photo gallery -- React/Vite frontend and Cloudflare Worker backend, R2 storage, D1-backed album metadata",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "generate": "node generate-albums.cjs",
    "prune": "node generate-albums.cjs --prune",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.2.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "terser": "^5.44.0",
    "vite": "^6.3.6"
  }
}
